# TeleSeek configuration. Copy to .env and adjust: cp .env.example .env
# All values below are placeholders — never commit a real .env.

# ─── Telegram bot ────────────────────────────────────────────────────────────
# Token from @BotFather. Leave empty to run the demo without Telegram
# (the bot container exits with a hint; the search CLI still works).
BOT_TOKEN=
# Display name used in bot messages.
BOT_NAME=TeleSeek
# Public bot username for the link at the end of result messages (without @).
# Empty = the bot uses its own username (from Telegram) at startup.
BOT_PUBLIC_USERNAME=
# Admin Telegram ids, comma-separated: admin commands + excluded from demand analytics.
ADMIN_IDS=123456789
# Results per page in the bot.
SEARCH_RESULTS_PER_PAGE=10
# Maximum accepted query length (characters).
MAX_QUERY_LENGTH=100

# ─── Database ────────────────────────────────────────────────────────────────
# Owner account created by the postgres container.
POSTGRES_DB=teleseek_db
POSTGRES_USER=teleseek
POSTGRES_PASSWORD=change-me
# Host/port for running the bot outside Docker (inside compose the host is "postgres").
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Connection URL for running outside Docker. Compose overrides it for its services.
DATABASE_URL=postgresql+asyncpg://teleseek:change-me@localhost:15432/teleseek_db
# Read-only role used by the panel (created by scripts/setup_roles.py).
POSTGRES_RO_PASSWORD=change-me-ro
# Narrow editor role used by the panel's write actions. Empty = view-only panel.
POSTGRES_EDITOR_PASSWORD=change-me-editor

# ─── Demo ────────────────────────────────────────────────────────────────────
# 1 = load synthetic demo data on first start (skipped if channels already exist).
DEMO_SEED=1
# Required (= yes) only for `python -m scripts.seed_data --reset`, which wipes all data.
SEED_CONFIRM=

# ─── Published ports (bound to 127.0.0.1) ────────────────────────────────────
POSTGRES_HOST_PORT=15432
PANEL_HOST_PORT=18090
ADMINER_HOST_PORT=18080

# ─── Search tuning ───────────────────────────────────────────────────────────
# Cap on post/media results; dedup and sorting run over the top-N rows.
MAX_RESULTS=300
# Regional result filter: comma-separated channels.section values hidden from results.
HIDDEN_SECTIONS=
# ILIKE fallback over post text when full-text search finds nothing (1 = on, 0 = off).
POST_ILIKE_FALLBACK=1
# Time budget for the ILIKE fallback, milliseconds (statement_timeout inside a savepoint).
POST_FALLBACK_TIMEOUT_MS=2000
# Row cap for the ILIKE fallback.
POST_FALLBACK_MAX_RESULTS=200
# Prefix fallback (lexeme:*) kicks in when exact matches are below this number.
PREFIX_FALLBACK_THRESHOLD=10
# pg_trgm thresholds for typo-tolerant channel lookup.
TRGM_TITLE_WS=0.45
TRGM_USERNAME_SIM=0.3

# ─── PostgreSQL tuning (defaults suit a 2 GB machine) ────────────────────────
PG_MEM_LIMIT=1280m
PG_SHM_SIZE=64m
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE=896MB
PG_WORK_MEM=12MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=50
# Optional preload libraries, e.g. pg_prewarm,pg_stat_statements
PG_PRELOAD=

# ─── Monitoring panel ────────────────────────────────────────────────────────
PANEL_PROJECT_NAME=TeleSeek
# Cache TTLs (seconds) for dashboard metrics, analytics and limits telemetry.
PANEL_METRICS_TTL_SEC=300
PANEL_ANALYTICS_TTL_SEC=900
PANEL_LIMITS_STATS_TTL_SEC=300
# Snapshot interval (seconds) and how often a snapshot includes the slow counters.
PANEL_SNAPSHOT_SEC=300
PANEL_SNAPSHOT_FULL_EVERY=6
# Snapshot history file (panel volume) and how many snapshots to keep.
PANEL_HISTORY_PATH=/data/metrics_history.jsonl
PANEL_HISTORY_MAX=4032
# Filesystem path whose usage is shown as "Disk".
PANEL_DISK_PATH=/
# Database URLs for running the panel outside Docker (compose builds them itself).
PANEL_DATABASE_URL=postgresql+asyncpg://teleseek_ro:change-me-ro@localhost:15432/teleseek_db
PANEL_EDITOR_DATABASE_URL=postgresql+asyncpg://teleseek_editor:change-me-editor@localhost:15432/teleseek_db
# Alerts: ingestion rate below this fraction of the hourly average…
ALERT_RATE_DROP_FRAC=0.3
# …but only when the average is at least this many posts per hour.
ALERT_RATE_MIN_AVG=500
# Alert when the ingestion queue has at least this many errors.
ALERT_ERROR_ABS=200

# ─── Maintenance scripts ─────────────────────────────────────────────────────
# scripts/build_channel_keywords.py: UPDATE batch size, candidate lexemes per channel,
# max share of channels a lexeme may appear in (above = generic word, dropped),
# min occurrences of a lexeme, keywords kept per channel.
KW_BATCH=200
KW_CAND_K=40
KW_DF_MAX=0.20
KW_MIN_NENTRY=2
KW_TOP_N=20
# scripts/regen_post_vectors.py: rows per batch and pause between batches (seconds).
REGEN_BATCH=5000
REGEN_SLEEP=0.3
